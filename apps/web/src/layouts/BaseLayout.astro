---
/**
 * BaseLayout — documento HTML, <head>/SEO foundation y estilos globales.
 * Genera lang, canonical, hreflang y og:locale a partir de `locale` y la URL.
 * No incluye Header/Footer (eso es PageLayout).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/solutions.css';
import '../styles/case-studies.css';
import '../styles/insights.css';
import '../styles/consent.css';
import '../styles/legal.css';

import CookieConsent from '../components/layout/CookieConsent.astro';
import { siteConfig } from '../content/static/site';
import { defaultLocale, localeMeta, type Locale } from '../i18n/config';
import { getLocalizedPath, getTranslations } from '../i18n/utils';
import { absoluteSeoUrl, breadcrumbSchema, globalSchemas, localeAlternates, pageDescription, pageTitle, type BreadcrumbItem, type LocalePaths, type OpenGraphType, xDefaultPath } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  /** Ruta o URL absoluta. Por defecto, la URL de la página actual (cada idioma es canonical de sí mismo). */
  canonical?: string;
  /** Ruta o URL absoluta de la imagen Open Graph (1200×630). */
  ogImage?: string;
  locale?: Locale;
  noindex?: boolean;
  /** An RSS endpoint for the current language/section. */
  rssFeed?: string;
  ogType?: OpenGraphType;
  breadcrumbs?: BreadcrumbItem[];
  /** Additional page-specific JSON-LD (e.g. Article). */
  structuredData?: Record<string, unknown>[];
  /**
   * Ruta real de esta página en cada idioma donde existe (p. ej. artículos con slug localizado
   * o sin traducción). Si se omite, se asume la misma ruta en todos los idiomas.
   */
  localePaths?: LocalePaths;
}

const { canonical, ogImage = siteConfig.defaultOgImage, locale = defaultLocale, noindex = false, localePaths, rssFeed, ogType = 'website', breadcrumbs = [], structuredData = [] } = Astro.props;
const t = getTranslations(locale);
const rawTitle = Astro.props.title;
const rawDescription = Astro.props.description;
const title = pageTitle(rawTitle, t.meta.title);
const description = pageDescription(rawDescription, t.meta.description);

const pathname = Astro.url.pathname;
const canonicalUrl = absoluteSeoUrl(canonical ?? pathname, Astro.site);
const ogImageUrl = absoluteSeoUrl(ogImage, Astro.site);
const siteUrl = absoluteSeoUrl('/', Astro.site);
const schema = [...globalSchemas(siteUrl), ...(breadcrumbSchema(breadcrumbs) ? [breadcrumbSchema(breadcrumbs)!] : []), ...structuredData];

// hreflang: solo en páginas localizadas (/en/…, /es/…). Centralizado aquí.
const available = localeAlternates(pathname, localePaths);
const alternates = available.map((a) => ({ hreflang: a.locale, href: absoluteSeoUrl(a.path, Astro.site) }));
const defaultPath = xDefaultPath(available);
const xDefault = defaultPath ? absoluteSeoUrl(defaultPath, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {rssFeed && <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Insights`} href={absoluteSeoUrl(rssFeed, Astro.site)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fuentes autoalojadas: preload de las dos variable fonts -->
    <link rel="preload" href="/fonts/orbitron-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/exo-2-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {available.filter((a) => a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={localeMeta[a.locale].ogLocale} />)}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Sin JS el contenido .reveal no debe quedar invisible -->
    <noscript><style>.reveal{opacity:1!important;transform:none!important;transition:none!important}</style></noscript>

    <!-- Marca JS activo: el reveal oculta contenido solo entonces (ver components.css) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
    <slot />
    <CookieConsent content={t.cookies} policyHref={getLocalizedPath(locale, '/legal/cookies/')} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
