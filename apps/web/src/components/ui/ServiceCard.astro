---
/** Tarjeta de catálogo. Solo recibe datos; sin href queda como elemento informativo (servicio sin página aún). */
interface Props {
  title: string;
  description?: string;
  href?: string;
  /** Etiqueta mostrada cuando no hay página (p. ej. "Coming soon"). */
  soonLabel?: string;
}
const { title, description, href, soonLabel } = Astro.props;
---

{
  href ? (
    <a class="link-card" href={href}>
      <span class="link-card-title">{title}</span>
      {description && <span class="link-card-body">{description}</span>}
      <span class="link-card-arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <div class="link-card link-card--static">
      <span class="link-card-title">{title}</span>
      {soonLabel && <span class="soon-tag">{soonLabel}</span>}
    </div>
  )
}
