---
import ServiceCard from '../ui/ServiceCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { servicePath, type Service } from '../../lib/catalog';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  heading: string;
  services: Service[];
}
const { locale, heading, services } = Astro.props;
---

<section class="section-band" aria-labelledby="related-heading">
  <SectionHeading id="related-heading" title={heading} />
  <div class="card-grid">
    {
      services.map((s) => (
        <ServiceCard title={s.name} description={s.shortDescription} href={servicePath(locale, s.familySlug, s.slug)} />
      ))
    }
  </div>
</section>
