---
/**
 * Vista ligera para el Home: artículos publicados del idioma (featured primero, luego fecha).
 * Sin artículos publicados mantiene el marcador "Coming soon".
 */
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import InsightCard from '../insights/InsightCard.astro';
import { insightsPath, type ArticleSummary } from '../../lib/insights';
import type { Locale } from '../../i18n/config';
import type { TranslationSchema } from '../../i18n/utils';

interface Props {
  locale: Locale;
  content: TranslationSchema['insights'];
  items: ArticleSummary[];
}
const { locale, content, items } = Astro.props;
---

<section class="insights section-band" id="insights" aria-labelledby="insights-heading">
  <SectionHeading id="insights-heading" eyebrow={content.eyebrow} title={content.title} />
  {
    items.length === 0 ? (
      <div class="why-card reveal"><p>{content.comingSoon}</p></div>
    ) : (
      <>
        <div class="insight-grid">
          {items.map((item) => <InsightCard item={item} locale={locale} content={content} />)}
        </div>
        <div class="hero-actions">
          <Button href={insightsPath(locale)} variant="secondary">{content.viewAll}</Button>
        </div>
      </>
    )
  }
</section>
