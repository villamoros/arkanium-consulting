---
/**
 * Entrada única para iniciar sesión. Clerk trae a la persona aquí tras autenticarse,
 * y el script decide a qué aplicación va según su organización (ver scripts/acceso.ts).
 * No es una página de contenido: no se indexa. Sin pie de página: solo muestra el estado del acceso.
 */
import AccessLayout from '../../layouts/AccessLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { getLocalizedPath, getTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale);

// Cuadrícula de 4 × 4 celdas: la onda sigue la diagonal (--i = fila + columna).
const cells = Array.from({ length: 16 }, (_, index) => {
  const row = Math.floor(index / 4);
  const column = index % 4;
  return row + column;
});
---

<AccessLayout locale={locale} title={t.access.title} description={t.access.description} noindex>
  <section class="access-page">
    <div class="access-status">
      <div class="lattice" data-access="checking" role="img" aria-label={t.access.checking}>
        {cells.map((wave) => <span style={`--i: ${wave}`} />)}
      </div>
      <h1>{t.access.title}</h1>
      <p data-access="checking">{t.access.checking}</p>
      <p data-access="none" hidden>{t.access.none}</p>
      <div data-access="error" class="access-error" hidden>
        <p>{t.access.error}</p>
        <p id="access-error-detail" class="access-detail"></p>
        <div id="access-error-actions" class="access-actions" data-home={getLocalizedPath(locale, '/')}></div>
      </div>
    </div>
  </section>
</AccessLayout>

<script>
  import '../../scripts/acceso';
</script>

<style is:global>
  /* El fondo cubre toda la pantalla, también debajo del contenido (sin banda de otro color). */
  html {
    background: var(--color-ink);
  }
</style>

<style>
  .access-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 48px 20px;
    text-align: center;
  }

  .access-status {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 480px;
  }

  .access-status h1 {
    margin: 0;
  }

  .access-status p {
    margin: 0;
    color: var(--color-muted);
  }

  /* Loader propio: celdas que se iluminan en onda, con los colores de la identidad. */
  .lattice {
    display: grid;
    grid-template-columns: repeat(4, 14px);
    gap: 6px;
    margin-bottom: 6px;
  }

  .access-error {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .access-error[hidden] {
    display: none;
  }

  .access-detail {
    font-size: 0.9rem;
  }

  .access-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
  }

  .lattice[hidden] {
    display: none;
  }

  .lattice span {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-graphite-2);
    opacity: 0.45;
    animation: lattice-wave 1.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 110ms);
  }

  @keyframes lattice-wave {
    0%,
    100% {
      background: var(--color-graphite-2);
      opacity: 0.45;
    }
    25% {
      background: var(--color-gold);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lattice span {
      animation: none;
      background: var(--color-gold);
      opacity: 0.6;
    }
  }
</style>
