---
/**
 * Páginas 2 en adelante del listado de Insights: /{idioma}/insights/page/{n}/.
 * Solo se generan las páginas que existen; la página 1 es /{idioma}/insights/.
 */
import PageLayout from '../../../../layouts/PageLayout.astro';
import InsightsArchive from '../../../../components/insights/InsightsArchive.astro';
import { siteConfig } from '../../../../content/static/site';
import { locales, type Locale } from '../../../../i18n/config';
import { getTranslations } from '../../../../i18n/utils';
import { getArticleSummaries, insightsPath } from '../../../../lib/insights';
import { pageCount, pageOf, splitListing } from '../../../../lib/insights/listing.ts';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const total = pageCount(splitListing(await getArticleSummaries(locale)).items.length);
    for (let n = 2; n <= total; n++) paths.push({ params: { locale, page: String(n) } });
  }
  return paths;
}

const locale = Astro.params.locale as Locale;
const page = Number(Astro.params.page);
const t = getTranslations(locale);
const c = t.insights;
const { items } = splitListing(await getArticleSummaries(locale));
const totalPages = pageCount(items.length);
if (!Number.isInteger(page) || page < 2 || page > totalPages) throw new Error(`[insights] Página inexistente: ${Astro.params.page} (${locale})`);
const title = `${c.eyebrow} · ${c.pageLabel.replace('{n}', String(page))} | ${siteConfig.name}`;
---

<PageLayout locale={locale} title={title} description={t.meta.description} rssFeed={insightsPath(locale).replace(/insights\/$/, 'rss.xml')}>
  <section class="page-hero section-band" aria-labelledby="insights-page-heading">
    <h1 id="insights-page-heading">{c.eyebrow}</h1>
  </section>
  <InsightsArchive
    locale={locale}
    content={c}
    items={pageOf(items, page)}
    page={page}
    totalPages={totalPages}
    basePath={insightsPath(locale)}
  />
</PageLayout>
