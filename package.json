{
  "name": "arkanium-platform",
  "private": true,
  "description": "Monorepo de Arkanium: apps (web, app, core, control), API de negocio y paquetes compartidos.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:all": "pnpm --parallel --filter @arkanium/web --filter @arkanium/api --filter @arkanium/app --filter @arkanium/core --filter @arkanium/control run dev"
  }
}
