---
/** PageLayout — BaseLayout + Header / <main> / Footer, con el contexto de idioma. */
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { defaultLocale } from '../i18n/config';
import { getTranslations } from '../i18n/utils';
import { getCatalog, toMenu } from '../lib/catalog';
import { insightsPath } from '../lib/insights';

export type Props = BaseProps;

const { locale = defaultLocale, localePaths } = Astro.props;
const t = getTranslations(locale);
// El menú Solutions refleja el catálogo (CMS en build); Astro lo emite como HTML.
const menu = toMenu(await getCatalog(locale), locale);
---

<BaseLayout {...Astro.props} locale={locale}>
  <Header locale={locale} navigation={t.navigation} ui={t.ui} menu={menu} localePaths={localePaths} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer locale={locale} content={t.footer} ui={t.ui} families={menu} allSolutionsLabel={t.navigation.allSolutions} insights={{ label: t.insights.eyebrow, href: insightsPath(locale) }} />
</BaseLayout>
