---
import RichText from './RichText.astro';
import ArticleToc from './ArticleToc.astro';
import InsightCover from './InsightCover.astro';
import { showToc, tableOfContents, withHeadingIds } from '../../lib/insights/listing.ts';
import type { Article } from '../../lib/insights';

interface Props {
  article: Article;
  tocLabel: string;
}
const { article, tocLabel } = Astro.props;
const toc = tableOfContents(article.content);
const hasToc = showToc(toc);
const nodes = withHeadingIds(article.content);
const image = article.featuredImage;
---

<section class="section-band article-band">
  <figure class="article-figure">
    <InsightCover image={image} variant="hero" />
    {image?.caption && <figcaption>{image.caption}</figcaption>}
  </figure>
  <div class:list={['article-layout', hasToc && 'article-layout--toc']}>
    {hasToc && <aside class="article-aside"><ArticleToc entries={toc} title={tocLabel} /></aside>}
    <div class="article-content">
      {hasToc && <ArticleToc entries={toc} title={tocLabel} mobile />}
      <RichText nodes={nodes} />
    </div>
  </div>
</section>
