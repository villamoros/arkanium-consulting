---
/** 404 controlado: también cubre idiomas no soportados (/xx/). Sin traducir: no hay idioma resoluble. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { localeMeta, locales } from '../i18n/config';
import { getLocalizedPath } from '../i18n/utils';
---

<BaseLayout title="Page not found | Arkanium Consulting" noindex>
  <main id="main" tabindex="-1">
    <section class="section-band" aria-labelledby="nf-heading">
      <p class="eyebrow">404</p>
      <h1 id="nf-heading">Page not found</h1>
      <p class="hero-lede">The page you are looking for does not exist or is not available in this language.</p>
      <div class="hero-actions">
        {locales.map((l, i) => <Button href={getLocalizedPath(l)} variant={i === 0 ? 'primary' : 'secondary'}>{localeMeta[l].name}</Button>)}
      </div>
    </section>
  </main>
</BaseLayout>
