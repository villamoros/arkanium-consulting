---
/**
 * Catálogo de Case Studies. Fuente: CMS (Storyblok, pendiente) → Astro (build) → HTML estático.
 * Secciones por naturaleza editorial: Featured · Real · Representative · Anonymized.
 */
import PageLayout from '../../../layouts/PageLayout.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import CaseStudyCard from '../../../components/case-studies/CaseStudyCard.astro';
import { siteConfig } from '../../../content/static/site';
import { locales, type Locale } from '../../../i18n/config';
import { getTranslations } from '../../../i18n/utils';
import { getCaseStudies, groupForListing } from '../../../lib/case-studies';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale);
const c = t.caseStudies;
const groups = groupForListing(await getCaseStudies(locale));
const sections = [
  { id: 'featured', title: c.groups.featured, items: groups.featured, intro: undefined },
  { id: 'real', title: c.groups.real, items: groups.real, intro: undefined },
  { id: 'representative', title: c.groups.representative, items: groups.representative, intro: c.representativeNote },
  { id: 'anonymized', title: c.groups.anonymized, items: groups.anonymized, intro: c.anonymizedNote },
].filter((s) => s.items.length > 0);
---

<PageLayout locale={locale} title={`${c.title} | ${siteConfig.name}`} description={t.meta.description}>
  <section class="page-hero section-band" aria-labelledby="cases-page-heading">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1 id="cases-page-heading">{c.title}</h1>
  </section>

  {
    sections.length === 0 ? (
      <section class="section-band"><p class="case-empty">{c.empty}</p></section>
    ) : (
      <section class="section-band">
        {sections.map((s) => (
          <div class="case-grid-section">
            <SectionHeading id={`cases-${s.id}-heading`} title={s.title} intro={s.intro} />
            <div class="case-grid">
              {s.items.map((item) => <CaseStudyCard item={item} locale={locale} content={c} />)}
            </div>
          </div>
        ))}
      </section>
    )
  }
</PageLayout>
