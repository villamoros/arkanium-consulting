{
  "id": "arkReunionConf01",
  "name": "Reunión confirmada → Google Calendar",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reunion-confirmada",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook reunión confirmada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "a1b2c3d4-0001-4000-8000-000000000011",
      "credentials": {
        "httpHeaderAuth": {
          "id": "arkWebhookAuth01",
          "name": "Arkanium webhook secret"
        }
      }
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "start": "={{ $json.body.startsAt }}",
        "end": "={{ $json.body.endsAt }}",
        "useDefaultReminders": false,
        "remindersUi": {
          "remindersValues": [{ "method": "popup", "minutes": 60 }]
        },
        "additionalFields": {
          "summary": "={{ $json.body.topic }}",
          "description": "={{ 'Reunión de Arkanium. Referencia interna: ' + $json.body.meetingId }}",
          "attendees": "={{ $json.body.attendees }}",
          "sendUpdates": "all",
          "conferenceDataUi": {
            "conferenceDataValues": {
              "conferenceSolution": "hangoutsMeet"
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Crear evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [240, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "PENDIENTE",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, eventId: $json.id, htmlLink: $json.htmlLink, meetLink: $json.hangoutLink ?? null } }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Responder a la API",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Webhook reunión confirmada": {
      "main": [[{ "node": "Crear evento", "type": "main", "index": 0 }]]
    },
    "Crear evento": {
      "main": [[{ "node": "Responder a la API", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "tags": []
}
