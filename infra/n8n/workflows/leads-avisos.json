{
  "id": "arkLeadsAvisos01",
  "name": "Avisos de leads (correo y Slack)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000001",
      "name": "Cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ARKANIUM_API_URL }}/internal/leads/pending-notification",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000002",
      "name": "Leads pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "arkWebhookAuth01",
          "name": "Arkanium webhook secret"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "leads",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000003",
      "name": "Un lead por vez",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $env.LEAD_EMAIL_FROM, to: [$env.LEAD_EMAIL_TO], reply_to: $json.email, subject: '[Lead] ' + $json.priority + ' — ' + $json.name, text: ['Nombre: ' + $json.name, 'Correo: ' + $json.email, 'Empresa: ' + ($json.company || '—'), 'Interés: ' + $json.priority, 'Idioma: ' + $json.locale, 'Origen: ' + $json.source, '', 'Contexto:', ($json.context || '—'), '', 'Consentimiento: versión ' + $json.consentTextVersion + ' aceptada el ' + $json.consentAcceptedAt].join('\\n') }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000004",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PENDIENTE",
          "name": "Resend API key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'Nuevo lead (' + $('Un lead por vez').item.json.locale + '): ' + $('Un lead por vez').item.json.name + ' — ' + $('Un lead por vez').item.json.priority }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ARKANIUM_API_URL }}/internal/leads/{{ $('Un lead por vez').item.json.id }}/notified",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000006",
      "name": "Marcar avisado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "arkWebhookAuth01",
          "name": "Arkanium webhook secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ARKANIUM_API_URL }}/internal/leads/{{ $('Un lead por vez').item.json.id }}/notify-failed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ error: 'correo: ' + (($json.error && $json.error.message) || 'error de envío') }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000007",
      "name": "Marcar fallo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "arkWebhookAuth01",
          "name": "Arkanium webhook secret"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0005-4000-8000-000000000008",
      "name": "Ejecutar a mano",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    }
  ],
  "connections": {
    "Cada 2 minutos": {
      "main": [
        [
          {
            "node": "Leads pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leads pendientes": {
      "main": [
        [
          {
            "node": "Un lead por vez",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Un lead por vez": {
      "main": [
        [
          {
            "node": "Enviar correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar correo": {
      "main": [
        [
          {
            "node": "Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Marcar fallo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack": {
      "main": [
        [
          {
            "node": "Marcar avisado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar a mano": {
      "main": [
        [
          {
            "node": "Leads pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "tags": []
}
