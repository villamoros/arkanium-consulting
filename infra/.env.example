# Copia a infra/.env y ajusta. Los valores reales no se versionan.
POSTGRES_USER=arkanium_dev
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=arkanium
# Clave de cifrado de n8n. Cámbiala por una aleatoria y no la pierdas: sin ella no se abren las credenciales guardadas.
N8N_ENCRYPTION_KEY=cambia-esta-clave

# Avisos de leads (n8n): remitente y destinatario del correo, y webhook de Slack. Los valores reales van solo en infra/.env.
LEAD_EMAIL_FROM=web@tu-dominio-verificado.com
LEAD_EMAIL_TO=hello@arkanium.consulting
SLACK_WEBHOOK_URL=cambia-por-el-webhook-de-slack
