{
  "name": "@arkanium/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de negocio de Arkanium. Monolito modular: tenancy, pipeline, engagement, agenda. Consumida por app, core y control.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:calendar": "tsx --env-file-if-exists=.env.local scripts/smoke-calendar.ts"
  },
  "dependencies": {
    "@arkanium/contracts": "workspace:*",
    "@clerk/backend": "^3.23.2",
    "@fastify/cors": "^11.3.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist"
  ]
}
