{
  "name": "@arkanium/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de negocio de Arkanium. Monolito modular: tenancy, pipeline, engagement, agenda. Consumida por app, core y control.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
