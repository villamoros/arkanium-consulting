    "test": "vitest run"
  },
  "dependencies": {
    "@arkanium/contracts": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist"
  ]
}
