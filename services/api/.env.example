# Nombres de variables. Los valores van en .env.local (no se versiona).
CLERK_SECRET_KEY=
ARKANIUM_ORG_ID=
CORS_ORIGINS=
PORT=3000
# Base de datos: PostgreSQL local en desarrollo, Supabase en producción (ARK-INF-001).
DATABASE_URL=
# Token que el sitio usa para entregar leads (F-01). Un valor largo y aleatorio.
LEAD_INTAKE_TOKEN=
# Calendario: base de los webhooks de n8n, y su secreto (el mismo valor que la credencial de n8n). Ver infra/n8n/workflows.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
